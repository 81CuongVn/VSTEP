# Backend Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains secrets!

# Application Settings
APP_NAME=Laravel
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=false
APP_URL=https://your-backend-url.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Database Configuration
DB_CONNECTION=pgsql
DB_SEED_ON_BOOT=true
DB_SSLMODE=require
DB_URL=postgresql://user:password@host:port/database?sslmode=require
DB_URL_DIRECT=postgresql://user:password@host:port/database?sslmode=require

# Session & Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Redis (Optional - for caching/sessions)
REDIS_URL=redis://default:password@host:port

# Mail Configuration
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Laravel

# Storage (Cloudflare R2 or similar)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_DEFAULT_REGION=auto
AWS_BUCKET=vstep
AWS_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true

# AI Services
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=southeastasia
OPENAI_API_KEY=your_openai_key
OPENAI_BASE_URL=your_openai_base_url

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://vstep.hamhochoi.com
CORS_ALLOWED_ORIGIN_PATTERNS=
FRONTEND_URL=https://vstep.hamhochoi.com

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Server Configuration (FrankenPHP/Octane)
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false
OCTANE_HOST=0.0.0.0
OCTANE_PORT=8000
OCTANE_ADMIN_HOST=127.0.0.1
OCTANE_ADMIN_PORT=2019
OCTANE_WORKERS=auto
OCTANE_MAX_REQUESTS=500
