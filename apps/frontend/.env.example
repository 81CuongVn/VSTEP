# Frontend Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains secrets!

# Backend API Configuration
# Empty/unset uses http://localhost:8000 in dev and same-origin /api/* in production.
# Set only when you need a custom backend base URL.
VITE_API_URL=

# Storage Configuration (R2 or similar)
VITE_STORAGE_URL=https://your-storage-url.r2.dev
